
.page-bg.data-v-776f6bed {
  min-height: 100vh;
  background: #f8faff;
}

/* 头部导航栏 */
.header-bar.data-v-776f6bed {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #3a9cff;
  padding: 20rpx 24rpx;
  color: #fff;
}
.header-left.data-v-776f6bed, .header-right.data-v-776f6bed {
  display: flex;
  align-items: center;
}
.back-btn.data-v-776f6bed, .home-btn.data-v-776f6bed, .more-btn.data-v-776f6bed, .minimize-btn.data-v-776f6bed, .focus-btn.data-v-776f6bed {
  font-size: 32rpx;
  padding: 8rpx;
}
.separator.data-v-776f6bed {
  font-size: 24rpx;
  margin: 0 8rpx;
  opacity: 0.7;
}
.header-title.data-v-776f6bed {
  font-size: 32rpx;
  font-weight: bold;
}

/* 搜索栏 */
.search-section.data-v-776f6bed {
  padding: 24rpx;
  background: #fff;
}
.search-bar.data-v-776f6bed {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.search-icon.data-v-776f6bed {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #999;
}
.search-input.data-v-776f6bed {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
}
.search-btn.data-v-776f6bed {
  background: #3a9cff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
}

/* 常见问题 */
.common-issues-section.data-v-776f6bed {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(58,156,255,0.08);
}
.section-header.data-v-776f6bed {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 16rpx 24rpx;
  background: #f8f9fa;
}
.section-icon.data-v-776f6bed {
  width: 40rpx;
  height: 40rpx;
  background: #3a9cff;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}
.section-title.data-v-776f6bed {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.issues-list.data-v-776f6bed {
  padding: 0 24rpx;
}
.issue-item.data-v-776f6bed {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}
.issue-item.data-v-776f6bed:last-child {
  border-bottom: none;
}
.issue-item.data-v-776f6bed:active {
  background: #f8f9fa;
}
.issue-text.data-v-776f6bed {
  font-size: 28rpx;
  color: #333;
}
.arrow-icon.data-v-776f6bed {
  font-size: 24rpx;
  color: #999;
}

/* 问题反馈按钮 */
.feedback-section.data-v-776f6bed {
  padding: 24rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #f0f0f0;
}
.feedback-btn.data-v-776f6bed {
  width: 100%;
  background: #3a9cff;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
}
