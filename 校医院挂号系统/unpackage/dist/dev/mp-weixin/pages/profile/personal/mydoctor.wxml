<view class="page-bg data-v-d3f48050"><view class="doctor-header data-v-d3f48050">我的医生</view><view class="search-section data-v-d3f48050"><input class="search-input data-v-d3f48050" placeholder="搜索医生姓名或科室" bindinput="{{a}}" value="{{b}}"/></view><view class="doctor-list data-v-d3f48050"><view wx:for="{{c}}" wx:for-item="item" wx:key="h" class="doctor-item data-v-d3f48050" bindtap="{{item.i}}"><view class="avatar data-v-d3f48050">👨‍⚕️</view><view class="info data-v-d3f48050"><view class="doctor-basic data-v-d3f48050"><text class="name data-v-d3f48050">{{item.a}}</text><text class="title data-v-d3f48050">{{item.b}}</text></view><text class="dept data-v-d3f48050">{{item.c}}</text><text wx:if="{{item.d}}" class="introduction data-v-d3f48050">{{item.e}}</text><view class="tags data-v-d3f48050"><text wx:for="{{item.f}}" wx:for-item="tag" wx:key="b" class="tag data-v-d3f48050">{{tag.a}}</text></view></view><view class="action data-v-d3f48050"><button class="contact-btn data-v-d3f48050" catchtap="{{item.g}}">联系</button></view></view></view><view wx:if="{{d}}" class="empty-state data-v-d3f48050"><text class="empty-text data-v-d3f48050">暂无医生信息</text></view><button class="main-btn data-v-d3f48050" bindtap="{{e}}">刷新医生列表</button></view>