
.profile-page.data-v-b5233218 {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e9f2ff 0%, #f7f9fc 100%);
}

/* 返回按钮 */
.back-section.data-v-b5233218 {
  display: flex;
  align-items: center;
  color: #2a7bff;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.back-icon.data-v-b5233218 {
  font-size: 40rpx;
  margin-right: 8rpx;
}
.back-text.data-v-b5233218 {
  font-size: 28rpx;
}

/* 头部信息 */
.profile-header.data-v-b5233218 {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 123, 255, 0.08);
  margin-bottom: 24rpx;
}
.avatar-section.data-v-b5233218 {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.avatar.data-v-b5233218 {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #e9f2ff;
}
.doctor-basic.data-v-b5233218 {
  display: flex;
  flex-direction: column;
}
.doctor-name.data-v-b5233218 {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.doctor-title.data-v-b5233218 {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7a8aa0;
}
.doctor-dept.data-v-b5233218 {
  margin-top: 12rpx;
}
.dept-name.data-v-b5233218 {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e9f2ff;
  color: #2a7bff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 统计 */
.stats-section.data-v-b5233218 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 123, 255, 0.08);
  margin-bottom: 24rpx;
}
.stat-item.data-v-b5233218 {
  flex: 1;
  text-align: center;
}
.stat-value.data-v-b5233218 {
  font-size: 36rpx;
  font-weight: 800;
  color: #2f3b52;
}
.stat-label.data-v-b5233218 {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a8aa0;
}
.stat-divider.data-v-b5233218 {
  width: 2rpx;
  height: 48rpx;
  background: #f0f5ff;
}

/* 通用区块 */
.info-section.data-v-b5233218,
.menu-section.data-v-b5233218 {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 123, 255, 0.08);
  margin-bottom: 24rpx;
}
.section-title.data-v-b5233218 {
  margin-bottom: 12rpx;
}
.title-text.data-v-b5233218 {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 信息列表 */
.info-list.data-v-b5233218 {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.info-item.data-v-b5233218 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.item-left.data-v-b5233218 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-icon.data-v-b5233218 {
  font-size: 28rpx;
}
.item-label.data-v-b5233218 {
  font-size: 26rpx;
  color: #7a8aa0;
}
.item-right.data-v-b5233218 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.item-value.data-v-b5233218 {
  font-size: 28rpx;
  color: #2f3b52;
  font-weight: 600;
}
.item-arrow.data-v-b5233218 {
  font-size: 40rpx;
  color: #a0b7e0;
}

/* 擅长领域 */
.specialty-container.data-v-b5233218 {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.specialty-text.data-v-b5233218 {
  font-size: 26rpx;
  color: #2f3b52;
}

/* 菜单 */
.menu-list.data-v-b5233218 {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.menu-item.data-v-b5233218 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.menu-left.data-v-b5233218 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.menu-icon.data-v-b5233218 {
  font-size: 28rpx;
}
.menu-label.data-v-b5233218 {
  font-size: 26rpx;
  color: #2f3b52;
}
.menu-arrow.data-v-b5233218 {
  font-size: 40rpx;
  color: #a0b7e0;
}

/* 退出登录 */
.logout-section.data-v-b5233218 {
  margin-top: 12rpx;
}
.logout-btn.data-v-b5233218 {
  width: 100%;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #ff3b30, #ff6b6b);
  box-shadow: 0 12rpx 20rpx rgba(255, 59, 48, 0.24);
}

/* 编辑弹窗 */
.dialog-mask.data-v-b5233218 {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.dialog-box.data-v-b5233218 {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 20rpx rgba(42, 123, 255, 0.16);
}
.dialog-title.data-v-b5233218 {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.dialog-input.data-v-b5233218 {
  margin-top: 16rpx;
  width: 100%;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2f3b52;
}
.dialog-actions.data-v-b5233218 {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}
.dialog-btn.data-v-b5233218 {
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.dialog-btn.cancel.data-v-b5233218 {
  background: #e9f2ff;
  color: #2a7bff;
}
.dialog-btn.save.data-v-b5233218 {
  background: linear-gradient(90deg, #2a7bff, #6aa9ff);
  color: #fff;
}
