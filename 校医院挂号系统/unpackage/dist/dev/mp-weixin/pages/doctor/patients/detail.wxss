
.patient-detail-page.data-v-0529fe2b {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(180deg, #e9f2ff 0%, #f7f9fc 100%);
}

/* 返回 */
.back-section.data-v-0529fe2b {
  display: flex;
  align-items: center;
  color: #2a7bff;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.back-icon.data-v-0529fe2b {
  font-size: 40rpx;
  margin-right: 8rpx;
}
.back-text.data-v-0529fe2b {
  font-size: 28rpx;
}

/* 卡片通用 */
.info-card.data-v-0529fe2b {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 123, 255, 0.08);
  margin-bottom: 24rpx;
}
.card-header.data-v-0529fe2b {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.card-title.data-v-0529fe2b {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 状态徽标 */
.status-badge.data-v-0529fe2b {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.status-pending.data-v-0529fe2b {
  color: #8a6d3b;
  background: #fff3cd;
}
.status-progress.data-v-0529fe2b {
  color: #0f5132;
  background: #d1e7dd;
}
.status-done.data-v-0529fe2b {
  color: #084298;
  background: #cfe2ff;
}

/* 基本信息网格 */
.info-grid.data-v-0529fe2b {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.info-item.data-v-0529fe2b {
  width: calc(50% - 8rpx);
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.info-item.full-width.data-v-0529fe2b {
  width: 100%;
}
.info-label.data-v-0529fe2b {
  font-size: 24rpx;
  color: #7a8aa0;
}
.info-value.data-v-0529fe2b {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #2f3b52;
  font-weight: 600;
}

/* 列表信息 */
.info-list.data-v-0529fe2b {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.list-item.data-v-0529fe2b {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}
.item-label.data-v-0529fe2b {
  color: #7a8aa0;
  font-size: 24rpx;
}
.item-value.data-v-0529fe2b {
  color: #2f3b52;
  font-size: 28rpx;
  font-weight: 600;
}

/* 病史 */
.privacy-tip.data-v-0529fe2b {
  color: #7a8aa0;
  font-size: 24rpx;
  margin-left: 8rpx;
}
.history-list.data-v-0529fe2b {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.history-item.data-v-0529fe2b {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 12rpx;
}
.history-tag.data-v-0529fe2b {
  background: #e9f2ff;
  color: #2a7bff;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
}
.history-text.data-v-0529fe2b {
  font-size: 26rpx;
  color: #2f3b52;
}
.empty-history.data-v-0529fe2b {
  padding: 24rpx;
  text-align: center;
  color: #7a8aa0;
}
.empty-text.data-v-0529fe2b {
  font-size: 26rpx;
}

/* 就诊历史 */
.visit-list.data-v-0529fe2b {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.visit-item.data-v-0529fe2b {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.visit-header.data-v-0529fe2b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.visit-date.data-v-0529fe2b {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #2f3b52;
  font-weight: 600;
}
.date-icon.data-v-0529fe2b {
  font-size: 28rpx;
}
.date-text.data-v-0529fe2b {
  font-size: 28rpx;
}
.visit-arrow.data-v-0529fe2b {
  font-size: 40rpx;
  color: #a0b7e0;
}
.visit-info.data-v-0529fe2b {
  display: flex;
  justify-content: space-between;
  color: #7a8aa0;
  font-size: 24rpx;
}
.visit-diagnosis.data-v-0529fe2b {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8aa0;
}
.diagnosis-label.data-v-0529fe2b {
  font-weight: 600;
}
.diagnosis-text.data-v-0529fe2b {
  color: #2f3b52;
}

/* 操作区 */
.action-section.data-v-0529fe2b {
  margin: 24rpx 0;
  display: flex;
  gap: 16rpx;
}
.action-btn.data-v-0529fe2b {
  flex: 1;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.receive-btn.data-v-0529fe2b {
  background: linear-gradient(90deg, #2a7bff, #6aa9ff);
  box-shadow: 0 12rpx 20rpx rgba(42, 123, 255, 0.24);
}
.complete-btn.data-v-0529fe2b {
  background: linear-gradient(90deg, #00c853, #52e176);
  box-shadow: 0 12rpx 20rpx rgba(0, 200, 83, 0.24);
}

/* 备注区 */
.note-section.data-v-0529fe2b {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 123, 255, 0.08);
}
.note-header.data-v-0529fe2b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.note-title.data-v-0529fe2b {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.note-textarea.data-v-0529fe2b {
  width: 100%;
  min-height: 160rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #2f3b52;
  box-sizing: border-box;
}
.note-footer.data-v-0529fe2b {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.char-count.data-v-0529fe2b {
  font-size: 24rpx;
  color: #7a8aa0;
}
.save-note-btn.data-v-0529fe2b {
  background: linear-gradient(90deg, #2a7bff, #6aa9ff);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}
