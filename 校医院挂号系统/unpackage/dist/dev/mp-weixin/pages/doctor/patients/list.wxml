<view class="patients-page data-v-102359a3"><view class="header data-v-102359a3"><text class="title data-v-102359a3">患者列表</text><button class="back data-v-102359a3" bindtap="{{a}}">返回</button></view><view class="filters data-v-102359a3"><view class="filter-card data-v-102359a3"><view class="filter-item data-v-102359a3"><text class="label data-v-102359a3">出诊日期</text><picker class="data-v-102359a3" mode="date" bindchange="{{c}}"><view class="picker data-v-102359a3">{{b}}</view></picker></view><view class="filter-item data-v-102359a3"><text class="label data-v-102359a3">时间段</text><picker class="data-v-102359a3" mode="selector" range="{{e}}" bindchange="{{f}}"><view class="picker data-v-102359a3">{{d}}</view></picker></view></view></view><view class="list data-v-102359a3"><view wx:if="{{g}}" class="empty-state data-v-102359a3"><text class="empty-text data-v-102359a3">暂无患者</text></view><view wx:else class="data-v-102359a3"><view wx:for="{{h}}" wx:for-item="p" wx:key="f" class="patient-card data-v-102359a3" bindtap="{{p.g}}"><view class="row data-v-102359a3"><text class="name data-v-102359a3">{{p.a}}</text><text class="identity data-v-102359a3">{{p.b}}</text></view><view class="row data-v-102359a3"><text class="slot data-v-102359a3">预约时段：{{p.c}}</text><text class="{{['status', 'data-v-102359a3', p.e]}}">{{p.d}}</text></view></view></view></view></view>