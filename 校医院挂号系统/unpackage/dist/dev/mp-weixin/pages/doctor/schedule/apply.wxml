<view class="apply-page data-v-cacad53e"><view class="header data-v-cacad53e"><view class="title data-v-cacad53e">申请调班</view><view class="subtitle data-v-cacad53e">请填写调班信息并提交</view></view><view class="card data-v-cacad53e"><view class="card-title data-v-cacad53e">申请信息</view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">原排班记录ID</view><input class="input data-v-cacad53e" type="number" placeholder="请输入原排班记录ID" value="{{a}}" bindinput="{{b}}"/></view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">目标日期</view><picker class="data-v-cacad53e" mode="date" value="{{d}}" bindchange="{{e}}"><view class="picker data-v-cacad53e">{{c}}</view></picker></view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">目标班次</view><view class="slots data-v-cacad53e"><view wx:for="{{f}}" wx:for-item="slot" wx:key="b" class="{{['slot', 'data-v-cacad53e', slot.c && 'active']}}" bindtap="{{slot.d}}">{{slot.a}}</view></view></view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">目标出诊科室ID</view><input class="input data-v-cacad53e" type="number" placeholder="请输入目标出诊科室ID" value="{{g}}" bindinput="{{h}}"/></view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">目标出诊科室名称</view><input class="input data-v-cacad53e" type="text" placeholder="请输入目标出诊科室名称" value="{{i}}" bindinput="{{j}}"/></view><view class="form-row data-v-cacad53e"><view class="label data-v-cacad53e">申请理由</view><block wx:if="{{r0}}"><textarea class="textarea data-v-cacad53e" auto-height placeholder="请简要说明调班原因（如就诊安排、个人事务等）" value="{{k}}" bindinput="{{l}}"/></block></view><button class="btn data-v-cacad53e" type="primary" disabled="{{m}}" loading="{{n}}" bindtap="{{o}}"> 提交申请 </button></view><view class="card data-v-cacad53e"><view class="card-title row data-v-cacad53e"><view class="data-v-cacad53e">我的申请记录</view><picker class="data-v-cacad53e" range="{{q}}" bindchange="{{r}}"><view class="filter data-v-cacad53e">{{p}}</view></picker></view><view wx:if="{{s}}" class="empty data-v-cacad53e">暂无记录</view><view wx:else class="list data-v-cacad53e"><view wx:for="{{t}}" wx:for-item="item" wx:key="i" class="item data-v-cacad53e"><view class="row data-v-cacad53e"><view class="{{['tag', 'data-v-cacad53e', item.b]}}">{{item.a}}</view><view class="time data-v-cacad53e">{{item.c}}</view></view><view class="desc data-v-cacad53e"><text class="data-v-cacad53e">原排班ID：{{item.d}}</text><text class="data-v-cacad53e"> → 目标：{{item.e}}（{{item.f}}）</text><text class="data-v-cacad53e">，科室ID：{{item.g}}</text></view><view class="reason data-v-cacad53e">理由：{{item.h}}</view></view></view></view></view>