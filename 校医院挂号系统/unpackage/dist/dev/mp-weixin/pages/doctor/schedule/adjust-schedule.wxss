
.adjust-page.data-v-4416a37b {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header.data-v-4416a37b {
  background: linear-gradient(135deg, #1677ff 0%, #4da3ff 100%);
  padding: 48rpx 32rpx;
  color: #fff;
  position: relative;
}
.header-back.data-v-4416a37b {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  cursor: pointer;
}
.back-icon.data-v-4416a37b {
  font-size: 48rpx;
  font-weight: 300;
  margin-right: 8rpx;
  line-height: 1;
}
.back-text.data-v-4416a37b {
  font-size: 28rpx;
  opacity: 0.95;
}
.header-content.data-v-4416a37b {
  display: flex;
  flex-direction: column;
}
.header-title.data-v-4416a37b {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.header-subtitle.data-v-4416a37b {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container.data-v-4416a37b {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.form-item.data-v-4416a37b {
  margin-bottom: 32rpx;
}
.form-item.data-v-4416a37b:last-child {
  margin-bottom: 0;
}
.form-label.data-v-4416a37b {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label-text.data-v-4416a37b {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.required.data-v-4416a37b {
  color: #ff4d4f;
  margin-left: 4rpx;
  font-size: 28rpx;
}

/* 选择器样式 */
.picker-content.data-v-4416a37b {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}
.placeholder.data-v-4416a37b {
  font-size: 28rpx;
  color: #999;
}
.value.data-v-4416a37b {
  font-size: 28rpx;
  color: #333;
}
.arrow.data-v-4416a37b {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
}

/* 文本输入框 */
.text-input.data-v-4416a37b {
  width: 100%;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 28rpx;
}

/* 文本域 */
.textarea-input.data-v-4416a37b {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 28rpx;
  line-height: 1.6;
}
.char-count.data-v-4416a37b {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 提示框 */
.tips-box.data-v-4416a37b {
  margin: 24rpx 32rpx;
  background: #e6f7ff;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #1677ff;
}
.tips-title.data-v-4416a37b {
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.tips-item.data-v-4416a37b {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
.tips-item.data-v-4416a37b:last-child {
  margin-bottom: 0;
}

/* 按钮组 */
.button-group.data-v-4416a37b {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.submit-btn.data-v-4416a37b,
.cancel-btn.data-v-4416a37b {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
.submit-btn.data-v-4416a37b {
  background: linear-gradient(135deg, #1677ff 0%, #4da3ff 100%);
  color: #fff;
}
.cancel-btn.data-v-4416a37b {
  background: #fff;
  color: #666;
  border: 2rpx solid #e8e8e8;
}
