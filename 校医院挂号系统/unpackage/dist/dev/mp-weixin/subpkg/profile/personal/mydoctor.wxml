<view class="page-bg data-v-bd09b79a"><view class="doctor-header data-v-bd09b79a">我的医生</view><view class="search-section data-v-bd09b79a"><input class="search-input data-v-bd09b79a" placeholder="搜索医生姓名或科室" bindinput="{{a}}" value="{{b}}"/></view><view class="doctor-list data-v-bd09b79a"><view wx:for="{{c}}" wx:for-item="item" wx:key="h" class="doctor-item data-v-bd09b79a" bindtap="{{item.i}}"><view class="avatar data-v-bd09b79a">👨‍⚕️</view><view class="info data-v-bd09b79a"><view class="doctor-basic data-v-bd09b79a"><text class="name data-v-bd09b79a">{{item.a}}</text><text class="title data-v-bd09b79a">{{item.b}}</text></view><text class="dept data-v-bd09b79a">{{item.c}}</text><text wx:if="{{item.d}}" class="introduction data-v-bd09b79a">{{item.e}}</text><view class="tags data-v-bd09b79a"><text wx:for="{{item.f}}" wx:for-item="tag" wx:key="b" class="tag data-v-bd09b79a">{{tag.a}}</text></view></view><view class="action data-v-bd09b79a"><button class="contact-btn data-v-bd09b79a" catchtap="{{item.g}}">联系</button></view></view></view><view wx:if="{{d}}" class="empty-state data-v-bd09b79a"><text class="empty-text data-v-bd09b79a">暂无医生信息</text></view><button class="main-btn data-v-bd09b79a" bindtap="{{e}}">刷新医生列表</button></view>