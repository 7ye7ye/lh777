<view class="page-bg data-v-ecb493c2"><view class="patient-header data-v-ecb493c2"><text class="header-title data-v-ecb493c2">我的就诊人</text><button class="add-btn data-v-ecb493c2" bindtap="{{a}}">+ 添加就诊人</button></view><view class="patient-list data-v-ecb493c2"><view wx:for="{{b}}" wx:for-item="patient" wx:key="i" class="patient-item data-v-ecb493c2"><view class="patient-info data-v-ecb493c2"><view class="patient-basic data-v-ecb493c2"><text class="patient-name data-v-ecb493c2">{{patient.a}}</text><text class="patient-gender data-v-ecb493c2">{{patient.b}}</text><text class="patient-age data-v-ecb493c2">{{patient.c}}岁</text></view><view class="patient-detail data-v-ecb493c2"><text class="patient-id data-v-ecb493c2">{{patient.d}}：{{patient.e}}</text><text class="patient-phone data-v-ecb493c2">手机：{{patient.f}}</text></view></view><view class="patient-actions data-v-ecb493c2"><button class="action-btn edit data-v-ecb493c2" bindtap="{{patient.g}}">编辑</button><button class="action-btn delete data-v-ecb493c2" bindtap="{{patient.h}}">删除</button></view></view></view><view wx:if="{{c}}" class="form-modal data-v-ecb493c2"><view class="form-content data-v-ecb493c2"><view class="form-header data-v-ecb493c2"><text class="form-title data-v-ecb493c2">{{d}}</text><text class="close-btn data-v-ecb493c2" bindtap="{{e}}">×</text></view><view class="form-tip data-v-ecb493c2">实名制就诊，请如实填写就诊信息</view><view class="form-body data-v-ecb493c2"><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">姓名*</text><input class="form-input data-v-ecb493c2" placeholder="请填写就诊人姓名" value="{{f}}" bindinput="{{g}}"/></view><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">证件类型*</text><picker class="data-v-ecb493c2" range="{{i}}" bindchange="{{j}}"><view class="form-input data-v-ecb493c2">{{h}}</view></picker></view><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">证件号码*</text><input class="form-input data-v-ecb493c2" placeholder="请填写证件号码" value="{{k}}" bindinput="{{l}}"/></view><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">性别*</text><picker class="data-v-ecb493c2" range="{{n}}" bindchange="{{o}}"><view class="form-input data-v-ecb493c2">{{m}}</view></picker></view><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">出生日期*</text><picker class="data-v-ecb493c2" mode="date" bindchange="{{q}}"><view class="form-input data-v-ecb493c2">{{p}}</view></picker></view><view class="form-item data-v-ecb493c2"><text class="form-label data-v-ecb493c2">手机号*</text><input class="form-input data-v-ecb493c2" placeholder="请填写手机号" value="{{r}}" bindinput="{{s}}"/></view></view><view class="form-actions data-v-ecb493c2"><button class="form-btn cancel data-v-ecb493c2" bindtap="{{t}}">取消</button><button class="form-btn submit data-v-ecb493c2" bindtap="{{v}}">提交</button></view></view></view></view>