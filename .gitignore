# 已有的规则
logs/
.idea/
校医院挂号系统/unpackage/
unpackage/
**/target/
target/


# 补充：Node.js 相关（你的项目有 node_modules）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml


# 补充：前端构建产物（web文件夹可能是前端项目）
web/dist/
web/build/
web/.next/
web/out/
web/.nuxt/
web/.output/


# 补充：后端相关（back-end可能是后端项目）
back-end/.gradle/
back-end/build/
back-end/out/
back-end/logs/  # 防止后端单独的logs


# 补充：编辑器/IDE 配置（已有.vscode，补充其他）
.vscode/*
