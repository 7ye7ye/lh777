<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.hospital.mapper.DoctorMapper">

    <resultMap id="BaseResultMap" type="org.jeecg.modules.hospital.entity.Doctor">
        <id property="doctorId" column="doctor_id"/>
        <result property="userId" column="user_id"/>
        <result property="deptId" column="dept_id"/>
        <result property="title" column="title"/>
        <result property="specialty" column="specialty"/>
        <result property="doctorDesc" column="doctor_desc"/>
        <result property="avatar" column="avatar"/>
        <result property="isActive" column="is_active"/>
        <result property="updateVerify" column="update_verify"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="deptName" column="dept_name"/>
    </resultMap>

    <sql id="Base_Column_List">
        d.doctor_id, d.user_id, d.dept_id, d.title, d.specialty, d.doctor_desc, d.avatar, d.is_active, d.update_verify, d.doctor_name, dept.dept_name
    </sql>

    <!-- 根据科室ID查询医生列表 -->
    <select id="selectByDeptId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctor d
        LEFT JOIN department dept ON d.dept_id = dept.dept_id
        WHERE d.dept_id = #{deptId} AND d.is_active = 1
        ORDER BY d.doctor_id ASC
    </select>

    <!-- 查询所有在职医生 -->
    <select id="selectActiveDoctors" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctor d
        LEFT JOIN department dept ON d.dept_id = dept.dept_id
        WHERE d.is_active = 1
        ORDER BY d.doctor_id ASC
    </select>

    <!-- 根据医生姓名模糊查询 -->
    <select id="selectByDoctorName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctor d
        LEFT JOIN department dept ON d.dept_id = dept.dept_id
        WHERE d.doctor_name LIKE CONCAT('%', #{doctorName}, '%') AND d.is_active = 1
        ORDER BY d.doctor_id ASC
    </select>

</mapper>
