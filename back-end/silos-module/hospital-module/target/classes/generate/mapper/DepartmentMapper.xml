<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.hospital.mapper.DepartmentMapper">

    <resultMap id="BaseResultMap" type="org.jeecg.modules.hospital.entity.Department">
        <id property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="parentDeptId" column="parent_dept_id"/>
        <result property="deptLevel" column="dept_level"/>
        <result property="deptDesc" column="dept_desc"/>
        <result property="location" column="location"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        dept_id, dept_name, parent_dept_id, dept_level, dept_desc, location, create_time, update_time
    </sql>

    <!-- 查询所有一级科室 -->
    <select id="selectFirstLevelDepartments" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        WHERE dept_level = 1
        ORDER BY dept_id ASC
    </select>

    <!-- 根据父科室ID查询二级科室 -->
    <select id="selectSecondLevelByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        WHERE parent_dept_id = #{parentDeptId} AND dept_level = 2
        ORDER BY dept_id ASC
    </select>

    <!-- 查询科室及下属二级科室 -->
    <select id="selectDepartmentWithChildren" resultMap="DepartmentWithChildrenResultMap">
        SELECT
        d1.dept_id AS d1_id, d1.dept_name AS d1_name, d1.dept_desc AS d1_desc,
        d2.dept_id AS d2_id, d2.dept_name AS d2_name, d2.dept_desc AS d2_desc, d2.location AS d2_location
        FROM department d1
        LEFT JOIN department d2 ON d1.dept_id = d2.parent_dept_id
        WHERE d1.dept_level = 1
        ORDER BY d1.dept_id, d2.dept_id
    </select>

    <resultMap id="DepartmentWithChildrenResultMap" type="java.util.HashMap">
        <result column="d1_id" property="deptId"/>
        <result column="d1_name" property="deptName"/>
        <result column="d1_desc" property="deptDesc"/>
        <collection property="children" ofType="java.util.HashMap">
            <result column="d2_id" property="deptId"/>
            <result column="d2_name" property="deptName"/>
            <result column="d2_desc" property="deptDesc"/>
            <result column="d2_location" property="location"/>
        </collection>
    </resultMap>
</mapper>
